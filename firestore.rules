rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Legacy JS workbench designs: readable, never writable from a browser. They used to be world-writable, and the
    // legacy pages ran their JavaScript (stored XSS); the pages now load JSON model data only.
    match /designs/{designId} {
      allow read: if true;
      allow write: if false;
    }
    // Board Studio designs: written ONLY by the server (service account bypasses rules),
    // so every change goes through the validation pipeline. No direct browser access.
    match /board_designs/{designId}/{document=**} {
      allow read, write: if false;
    }
  }
}
